# imgtrans 服务配置模板。复制为 .env 后填入真实值：cp .env.example .env
#
# 调用方请求头需带 X-Api-Key: <key>（也接受 Authorization: Bearer <key>）
IMGTRANS_API_KEY=change-me-to-a-random-40-char-secret

# 访问 Google 翻译 / 下载图片用的代理；服务器可直连出海时留空或删掉这行
IMGTRANS_PROXY=

# 监听地址与端口
IMGTRANS_HOST=127.0.0.1
IMGTRANS_PORT=8000

# 推理设备：cpu（默认）/ gpu / gpu:0 / gpu:1 / auto（有卡就用卡，无卡回落 cpu）
#
# 默认 cpu。用 GPU 需要装 GPU 版 paddlepaddle-gpu（pip install paddlepaddle-gpu），
# 否则程序会在启动时明确报错退出，而不是悄悄跑回 CPU。
# 想在「有卡用卡、没卡用 cpu」的机器间共用同一份配置，写 auto。
IMGTRANS_DEVICE=cpu

# 额外字体目录，多个用 ; 或 : 分隔（优先级高于系统目录）
# Linux 容器里字体常放 /opt/fonts；不设则只扫系统字体目录
# IMGTRANS_FONT_DIRS=/opt/fonts

# 模型缓存目录。默认 PaddleX 会下到 ~/.paddlex（约 240MB），
# 同机的多个 paddle 项目会共用同一份缓存，版本一换就互相干扰。
# 指向项目内目录即可彻底独立：删项目目录 = 清掉模型。
# 相对路径以项目根为基准（不是 cwd）。
IMGTRANS_MODEL_DIR=.models
