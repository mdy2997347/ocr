# imgtrans 服务配置模板。复制为 .env 后填入真实值：cp .env.example .env
#
# 调用方请求头需带 X-Api-Key: <key>（也接受 Authorization: Bearer <key>）
IMGTRANS_API_KEY=change-me-to-a-random-40-char-secret

# 访问 Google 翻译 / 下载图片用的代理；服务器可直连出海时留空或删掉这行
IMGTRANS_PROXY=

# 翻译通道。默认 web（免费 web 接口，抓的是 translate.google.com 的页面接口）。
#
# 【强烈建议生产用 cloud】免费通道有两个硬伤：
#   1. 机房/云厂商 IP 会被 Google 判定为机器人，直接 429 限流——
#      表现为"接口返回 200 + 一张原封不动的中文图"，日志里只有 circuit_open；
#   2. 每次翻译一张图要发几十条请求，量一上来必然触发限流。
# cloud 走官方 Cloud Translation v2，有配额与错误码，不会静默降级。
#
# 可选值：web / api / free（免费，易 429）| cloud / nmt（官方 API，需 Key）
IMGTRANS_TRANSLATOR=web

# cloud 通道的凭证（三选一，按优先级）：
#   IMGTRANS_GOOGLE_KEY          —— API Key，最省事，v2 接口按 Key 计费
#   IMGTRANS_GOOGLE_CREDENTIALS  —— 服务账号 JSON 的路径
#   IMGTRANS_GOOGLE_PROJECT      —— 项目 ID（配合上一条使用）
# 用 cloud 还需要 google-cloud-translate 这个包（官方 SDK，会连带装 grpc，约 20MB），
# 它不在默认依赖里：需要时把 google-cloud-translate 加进 pyproject 再 uv lock。
# 未装该包时 cloud 通道会在第一次翻译时报 TranslatorUnavailable 并给出安装指引。
# IMGTRANS_GOOGLE_KEY=
# IMGTRANS_GOOGLE_CREDENTIALS=/etc/imgtrans/gcp-sa.json
# IMGTRANS_GOOGLE_PROJECT=

# 监听地址与端口
IMGTRANS_HOST=127.0.0.1
IMGTRANS_PORT=8000

# 推理设备：cpu（默认）/ gpu / gpu:0 / gpu:1 / auto（有卡就用卡，无卡回落 cpu）
#
# 默认 cpu。用 GPU 需要装 GPU 版 paddlepaddle-gpu（pip install paddlepaddle-gpu），
# 否则程序会在启动时明确报错退出，而不是悄悄跑回 CPU。
# 想在「有卡用卡、没卡用 cpu」的机器间共用同一份配置，写 auto。
IMGTRANS_DEVICE=cpu

# 额外字体目录，多个用 ; 或 : 分隔（优先级高于系统目录）
# Linux 容器里字体常放 /opt/fonts；不设则只扫系统字体目录
# IMGTRANS_FONT_DIRS=/opt/fonts

# 模型缓存目录。默认 PaddleX 会下到 ~/.paddlex（约 240MB），
# 同机的多个 paddle 项目会共用同一份缓存，版本一换就互相干扰。
# 指向项目内目录即可彻底独立：删项目目录 = 清掉模型。
# 相对路径以项目根为基准（不是 cwd）。
IMGTRANS_MODEL_DIR=.models
